        },
        {
          "href": "coap://[2001:b07:5d2e:6af2:f29e:4aff:fe8c:a366]:5683/relativisticroom/actions/toggleCooler",
          "contentType": "application/json",
          "op": "invokeaction"
        }
      ],
      "idempotent": false,
      "safe": false
    },
    "reset": {
      "description": "Reset the room",
      "forms": [
        {
          "href": "http://192.168.1.110:8079/relativisticroom/actions/reset",
          "contentType": "application/json",
          "op": ["invokeaction"],
          "htv:methodName": "POST"
        },
        {
          "href": "http://[2001:b07:5d2e:6af2:f29e:4aff:fe8c:a366]:8079/relativisticroom/actions/reset",
          "contentType": "application/json",
          "op": ["invokeaction"],
          "htv:methodName": "POST"
        },
        {
          "href": "coap://192.168.1.110:5683/relativisticroom/actions/reset",
          "contentType": "application/json",
          "op": "invokeaction"
        },
        {
          "href": "coap://[2001:b07:5d2e:6af2:f29e:4aff:fe8c:a366]:5683/relativisticroom/actions/reset",
          "contentType": "application/json",
          "op": "invokeaction"
        }
      ],
      "idempotent": false,
      "safe": false
    },
    "setSimParameters": {
      "description": "Set the parameters for the simulator of the room",
      "input": { "type": "object" },
      "forms": [
        {
          "href": "http://192.168.1.110:8079/relativisticroom/actions/setSimParameters",
          "contentType": "application/json",
          "op": ["invokeaction"],
          "htv:methodName": "POST"
        },
        {
