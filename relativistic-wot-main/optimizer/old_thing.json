          "contentType": "application/json",
          "op": ["observeproperty", "unobserveproperty"],
          "subprotocol": "longpoll"
        },
        {
          "href": "coap://192.168.1.110:5683/relativisticroom/properties/time",
          "contentType": "application/json",
          "op": ["readproperty", "observeproperty", "unobserveproperty"]
        },
        {
          "href": "coap://[2001:b07:5d2e:6af2:f29e:4aff:fe8c:a366]:5683/relativisticroom/properties/time",
          "contentType": "application/json",
          "op": ["readproperty", "observeproperty", "unobserveproperty"]
        }
      ]
    },
    "temperature": {
      "type": "number",
      "description": "Current temperature in the room",
      "observable": true,
      "readOnly": true,
      "uriVariables": { "time": { "type": "number" } },
      "writeOnly": false,
      readOnly = false -> writable properties, we do not need to learn the model because we already know it (the value of the property is what you write on)
      readOnly  = true -> we need to discover its model (its parameters of the model)
      

      dot(x) = f(x)
      y = x

      min |y - y_obs|

      \dot{x}_1 = p_1 * (p_2 - x) + \sum{h : modelType(h) = @heatPower} model(h) \\
      p_1 \ge 0

      "model": "dot(self) = val(@humidity) + params[0] * (params[1] - value) + sum(h in model(@heatPower)), params[0] >= 0.0", # dot, jump, sum, prod, sum( params[i] * h in @heatPower)
      "forms": [
        {
          "href": "http://192.168.1.110:8079/relativisticroom/properties/temperature{?time}",
          "contentType": "application/json",
          "op": ["readproperty"],
          "htv:methodName": "GET"
        },
        {
          "href": "http://192.168.1.110:8079/relativisticroom/properties/temperature/observable",
          "contentType": "application/json",
          "op": ["observeproperty", "unobserveproperty"],
          "subprotocol": "longpoll"
        },
        {
          "href": "http://[2001:b07:5d2e:6af2:f29e:4aff:fe8c:a366]:8079/relativisticroom/properties/temperature{?time}",
          "contentType": "application/json",
          "op": ["readproperty"],
          "htv:methodName": "GET"
        },
        {
          "href": "http://[2001:b07:5d2e:6af2:f29e:4aff:fe8c:a366]:8079/relativisticroom/properties/temperature/observable",
          "contentType": "application/json",
          "op": ["observeproperty", "unobserveproperty"],
          "subprotocol": "longpoll"
        },
        {
